{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroFlow",
  "version": "1.0.0",
  "identifier": "com.neuroflow.core",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NeuroFlow Core", 
        "width": 1000, 
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 NeuroFlow Dev",
    "shortDescription": "赛博朋克风格的智能网络监控系统"
  }
}