{
  "manifest_version": 3,
  "name": "NeuroFlow Link - 浏览器神经中枢",
  "version": "1.2.0",
  "description": "NeuroFlow 的浏览器感知触角。负责语义分析、资源调度与神经连接。",
  
  "permissions": [
    "tabs",            
    "storage",         
    "webNavigation",   
    "browsingData",    
    "scripting"        
  ],
  
  "host_permissions": [
    "http://127.0.0.1:3030/*"
  ],
  
  "action": {
    "default_title": "NeuroFlow 状态: 运行中",
    "default_popup": "popup.html" 
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

